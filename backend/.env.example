PORT=5000
NODE_ENV=production
CLIENT_URL=http://<your-frontend-domain-or-ip>
FRONTEND_URL=http://<your-frontend-domain-or-ip>

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/studyvault?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=studyvault-priti-documents-2026

# Note: When deploying to EC2 with an attached IAM Role (StudyVaultEC2Role),
# do NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY. Leave them commented out.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
